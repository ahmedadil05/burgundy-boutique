# ==============================================================================
# BURGUNDY (بيرغندي) - Production Environment Variables
# Qatar E-Commerce & Luxury Hand-Painted Apparel
# ==============================================================================

# Core Application
NEXT_PUBLIC_SITE_URL=https://burgundy.qa
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_STORE_NAME_AR=بيرغندي
NEXT_PUBLIC_STORE_NAME_EN=BURGUNDY
NEXT_PUBLIC_INSTAGRAM=@burgundy974_

# Qatar Compliance & Legal Business Credentials
NEXT_PUBLIC_CR_NUMBER=CR-189420-QA
NEXT_PUBLIC_LICENSE_NUMBER=ECOM-2026-974
NEXT_PUBLIC_TAX_ENABLED=false
NEXT_PUBLIC_TAX_RATE_PERCENT=0

# Admin Access Credentials
ADMIN_SECRET_PIN=9740
ADMIN_SESSION_SECRET=burgundy_luxury_artisan_secret_token_974

# Qatar Payment Rails & Gateway Integration
# Supported: card, qpay, fawran, wire, cod
PAYMENT_GATEWAY_PROVIDER=myfatoorah # Options: myfatoorah, dibsy, skipcash, mock
MYFATOORAH_API_KEY=your_myfatoorah_token_here
MYFATOORAH_ENDPOINT=https://api.myfatoorah.com
BANK_TRANSFER_IBAN=QA00QNBA000000000000000000000
BANK_TRANSFER_BANK_NAME=QNB (Qatar National Bank)
BANK_TRANSFER_ACCOUNT_NAME=BURGUNDY TRADING W.L.L.

# Notifications: Telegram Bot (Primary instant admin alert)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_admin_chat_id_here
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret

# Notifications: WhatsApp Cloud API (Behind feature flag)
FEATURE_WHATSAPP_ALERTS=false
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id

# Email Delivery (SMTP / Resend / SendGrid)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASSWORD=your_resend_api_key_here
EMAIL_FROM="BURGUNDY <orders@burgundy.qa>"
EMAIL_ADMIN=admin@burgundy.qa
